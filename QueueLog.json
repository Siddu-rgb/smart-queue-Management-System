{
  "name": "QueueLog",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business ID"
    },
    "token_id": {
      "type": "string",
      "title": "Token ID"
    },
    "token_number": {
      "type": "number",
      "title": "Token Number"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "service_type": {
      "type": "string",
      "title": "Service"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "wait_duration": {
      "type": "number",
      "title": "Wait Duration (min)"
    },
    "service_duration": {
      "type": "number",
      "title": "Service Duration (min)"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "completed",
        "skipped",
        "cancelled"
      ]
    }
  },
  "required": [
    "business_id",
    "token_number"
  ]
}