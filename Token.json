{
  "name": "Token",
  "type": "object",
  "properties": {
    "token_number": {
      "type": "number",
      "title": "Token Number"
    },
    "business_id": {
      "type": "string",
      "title": "Business ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    },
    "service_type": {
      "type": "string",
      "title": "Service Type"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "waiting",
        "called",
        "serving",
        "completed",
        "skipped",
        "cancelled"
      ],
      "default": "waiting"
    },
    "counter_number": {
      "type": "number",
      "title": "Counter Number"
    },
    "estimated_wait": {
      "type": "number",
      "title": "Estimated Wait (min)"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "normal",
        "vip",
        "emergency"
      ],
      "default": "normal"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "called_at": {
      "type": "string",
      "title": "Called At"
    },
    "served_at": {
      "type": "string",
      "title": "Served At"
    },
    "is_walkin": {
      "type": "boolean",
      "title": "Walk-in",
      "default": true
    }
  },
  "required": [
    "token_number",
    "business_id",
    "customer_name",
    "status"
  ]
}